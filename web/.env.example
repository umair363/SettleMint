# Copy to web/.env.local. The v1 API (npm run dev:v1).
NEXT_PUBLIC_API_URL=http://localhost:8001
# Show the Google button only when the API has Google sign-in configured.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
# Public address of the site (canonical links, sitemap, share previews).
NEXT_PUBLIC_SITE_URL=https://www.settlemint.online

# Copy to mobile/.env (never commit it).
# The API. A phone can't reach "localhost" on your computer: use its network
# address in development (e.g. http://192.168.1.20:8001), and
# https://api.settlemint.online for real builds.
EXPO_PUBLIC_API_URL=http://localhost:8001
# The web app (invite links, terms, privacy).
EXPO_PUBLIC_WEB_URL=https://app.settlemint.online
# 1 once Google sign-in is set up on the API.
EXPO_PUBLIC_GOOGLE_SIGN_IN=

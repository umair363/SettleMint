{
  "name": "api",
  "version": "1.0.0",
  "description": "SettleMint API (v1): Fastify, Drizzle, Postgres, Better Auth",
  "scripts": {
    "build": "npm run build -w @settlemint/shared && tsc && node -e \"require('fs').cpSync('src/v1/db/migrations','dist/v1/db/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:v1": "tsx watch src/v1/main.ts",
    "start:v1": "node dist/v1/main.js",
    "v1:db:generate": "drizzle-kit generate --config drizzle.v1.config.ts"
  },
  "author": "Umair",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@better-auth/expo": "^1.7.25",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.4",
    "@settlemint/shared": "*",
    "better-auth": "^1.7.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "resend": "^6.12.4",
    "uuidv7": "^1.2.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^25.9.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "private": true
}

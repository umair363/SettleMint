# Copy to api/.env and fill in. Never commit the real file.

# Postgres (local: `npm run db:up` from the repo root)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/settlemint

# Long random string: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=

PORT=8000
# Web app origin. Required in production (used for CORS and links in emails).
FRONTEND_URL=http://localhost:3000

# Email (Resend). Without a key, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="SettleMint <onboarding@resend.dev>"

# Receipt scanning (Google Gemini). Scanning is off without a key.
# Note: Gemini's free tier may use submitted content to improve Google's
# products; the privacy policy says so.
GEMINI_API_KEY=
# Receipt scans per person per month (keeps AI cost bounded). Default 30.
AI_SCANS_PER_MONTH=30
# Local development only: "1" returns a sample receipt instead of calling the AI.
FAKE_RECEIPT_READER=
# Browser tests only: "off" disables sign-in rate limits (ignored in production).
AUTH_RATE_LIMIT=

# Push notifications (free, no third-party account). Generate once with:
#   npx web-push generate-vapid-keys
# and keep the same pair forever (changing it silently drops every subscription).
# Notifications are off while these are empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@settlemint.online
# Phone notifications go through Expo's free push service and need nothing here,
# unless you switch on "enhanced push security" for the Expo project.
EXPO_ACCESS_TOKEN=

# Optional services used by the current API (removed in v2)
REDIS_URL=redis://localhost:6379
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=local_dev_only_key

# Error reporting (optional)
SENTRY_DSN=

# Keep Render's free plan awake: the server pings this URL every ~10 minutes.
# Set it to the service's own public /health URL in production; leave empty locally.
# /health never touches the database, so Neon can still sleep.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MINUTES=10

# ─── v1 API (npm run dev:v1, port 8001) ────────────────────────────────────
# Separate database; migrations run automatically on start-up.
# Leave empty for local development: a file-based PGlite database in api/.data
# is used instead, so no Postgres install is needed.
V1_DATABASE_URL=
# Public URL of the v1 API, used for auth callbacks.
API_URL=http://localhost:8001
# Comma-separated web origins allowed to call the API with cookies.
WEB_ORIGINS=http://localhost:3001
# At least 32 random characters. Required in production.
AUTH_SECRET=
# e.g. .settlemint.online to share the session between the web app and api subdomain.
COOKIE_DOMAIN=
# Optional sign-in providers; each is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=

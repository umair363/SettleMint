# Copy to api/.env and fill in. Never commit the real file.
# Everything here is optional for local development: `npm run dev:v1` works
# with an empty .env (built-in database, codes printed to the console).

# ─── Server ────────────────────────────────────────────────────────────────
PORT=8001
# Public URL of this API, used for sign-in callbacks.
API_URL=http://localhost:8001
# Comma-separated web origins allowed to call the API with cookies.
WEB_ORIGINS=http://localhost:3001

# ─── Database ──────────────────────────────────────────────────────────────
# Postgres (production: Neon's pooled connection string). Migrations run on start-up.
# Empty: a file-based PGlite database in api/.data is used, so no Postgres is needed.
# For a local Postgres instead: `npm run db:up` from the repo root, then
#   V1_DATABASE_URL=postgres://postgres:postgres@localhost:5432/settlemint_v1
V1_DATABASE_URL=

# ─── Sign-in ───────────────────────────────────────────────────────────────
# At least 32 random characters. Required in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# e.g. .settlemint.online to share the session between the web app and the API subdomain.
COOKIE_DOMAIN=
# Optional providers; each is on only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=
# Browser tests only: "off" disables sign-in rate limits (ignored in production).
AUTH_RATE_LIMIT=

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Without a key, emails (sign-in codes) are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="SettleMint <onboarding@resend.dev>"

# ─── Receipt scanning (Google Gemini) ──────────────────────────────────────
# Off without a key. Gemini's free tier may use submitted content to improve
# Google's products; the privacy policy says so.
GEMINI_API_KEY=
# Scans per person per month (keeps AI cost bounded). Default 30.
AI_SCANS_PER_MONTH=30
# Local development only: "1" returns a sample receipt instead of calling the AI.
FAKE_RECEIPT_READER=

# ─── Notifications ─────────────────────────────────────────────────────────
# Browsers (Web Push, free, no account). Generate once with
#   npx web-push generate-vapid-keys
# and keep the same pair forever (changing it silently drops every subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@settlemint.online
# Phones go through Expo's free push service and need nothing here, unless you
# switch on "enhanced push security" for the Expo project.
EXPO_ACCESS_TOKEN=

# ─── Free hosting ──────────────────────────────────────────────────────────
# Keep Render's free plan awake: the server pings this URL every ~10 minutes.
# Set it to the service's own public /health URL in production; leave empty locally.
# /health never touches the database, so Neon can still sleep.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MINUTES=10

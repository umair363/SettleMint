# Copy to api/.env and fill in. Never commit the real file.

# Postgres (local: `npm run db:up` from the repo root)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/settlemint

# Long random string: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=

PORT=8000
# Web app origin. Required in production (used for CORS and links in emails).
FRONTEND_URL=http://localhost:3000

# Email (Resend). Without a key, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="SettleMint <onboarding@resend.dev>"

# Receipt scanning and text entry (Google Gemini)
GEMINI_API_KEY=

# Optional services used by the current API (removed in v2)
REDIS_URL=redis://localhost:6379
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=local_dev_only_key

# Error reporting (optional)
SENTRY_DSN=
